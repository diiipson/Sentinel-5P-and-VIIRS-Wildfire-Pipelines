# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Virtual environments
.venv/
venv/
env/

# Local tool/IDE settings (machine-specific, not project data)
.claude/
.vscode/

# Raw and derived data products (large binary/geospatial files; not tracked in git)
*.nc
*.h5
*.hdf
*.csv
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.tif
*.tiff

# Generated figures
*.png
*.jpg
*.jpeg
*.pdf

# Exception: curated sample figures we do want tracked
!sample_outputs/*.png
!sample_outputs/*.jpg
!sample_outputs/*.jpeg
!sample_outputs/*.tif
!sample_outputs/*.tiff
